# Copy this file to `.env.local` (which is git-ignored) and set the value
# below to your GitHub Codespace name. This is required so the frontend can
# reach the backend API at:
#   https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api/[component]/
#
# Find your Codespace name by running `echo $CODESPACE_NAME` in a terminal
# inside the Codespace.
VITE_CODESPACE_NAME=
